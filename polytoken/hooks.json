[
  {
    "event": "pre_tool_use",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" git-safe/hook.sh shell"
    },
    "matcher": "shell_exec",
    "name": "git-safe"
  },
  {
    "event": "pre_tool_use",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" read-once/hook.sh read"
    },
    "matcher": "file_read",
    "name": "read-once"
  },
  {
    "event": "post_compaction",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" read-once/compact.sh compact"
    },
    "name": "read-once-reset"
  },
  {
    "event": "session_start",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/container-awareness.sh\""
    },
    "name": "container-awareness"
  },
  {
    "event": "pre_tool_use",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" grep-guard/hook.sh grep"
    },
    "matcher": "Grep",
    "name": "grep-guard"
  },
  {
    "event": "pre_tool_use",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" large-read-guard/hook.sh read"
    },
    "matcher": "file_read",
    "name": "large-read-guard"
  },
  {
    "event": "post_model_turn",
    "handler": {
      "bash": "exec '/home/dev/.local/bin/polytoken-quota' notice-hook --notice '/home/dev/.local/polytoken-quota/notice.json'"
    },
    "name": "polytoken-quota-reload"
  },
  {
    "event": "pre_user_prompt",
    "handler": {
      "bash": "exec '/home/dev/.local/bin/polytoken-quota' notice-hook --notice '/home/dev/.local/polytoken-quota/notice.json'"
    },
    "name": "polytoken-quota-drift"
  },
  {
    "event": "session_start",
    "handler": {
      "bash": "exec bash \"$HOME/.config/polytoken/superpowers/session-start-polytoken\""
    },
    "name": "superpowers-session-start"
  },
  {
    "event": "post_compaction",
    "handler": {
      "bash": "exec bash \"$HOME/.config/polytoken/superpowers/session-start-polytoken\""
    },
    "name": "superpowers-post-compaction"
  },
  {
    "event": "notification",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/agent-notify.sh\" polytoken"
    },
    "name": "agent-notify"
  },
  {
    "event": "pre_user_prompt",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/agent-notify.sh\" polytoken"
    },
    "name": "agent-notify-cancel"
  },
  {
    "event": "stop",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/agent-notify.sh\" polytoken"
    },
    "name": "agent-notify-stop"
  },
  {
    "event": "pre_tool_use",
    "matcher": "ask_user_question",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/agent-notify.sh\" polytoken"
    },
    "name": "agent-notify-ask"
  },
  {
    "event": "post_tool_use",
    "matcher": "ask_user_question",
    "handler": {
      "bash": "bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/agent-notify.sh\" polytoken"
    },
    "name": "agent-notify-answer"
  }
]
