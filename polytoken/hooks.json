[
  {"event":"pre_tool_use","handler":{"bash":"bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" git-safe/hook.sh shell"},"matcher":"shell_exec","name":"git-safe"},
  {"event":"pre_tool_use","handler":{"bash":"bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" hooks/no-remote-writes.sh shell"},"matcher":"shell_exec","name":"no-remote-writes"},
  {"event":"pre_tool_use","handler":{"bash":"bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" read-once/hook.sh read"},"matcher":"file_read","name":"read-once"},
  {"event":"post_compaction","handler":{"bash":"bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" read-once/compact.sh compact"},"name":"read-once-reset"},
  {"event":"session_start","handler":{"bash":"bash \"${POLYTOKEN_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/polytoken}/hooks/bridge-connector-autostart.sh\""},"name":"bridge-connector-autostart"},
  {"event":"pre_tool_use","handler":{"bash":"bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" grep-guard/hook.sh grep"},"matcher":"Grep","name":"grep-guard"},
  {"event":"pre_tool_use","handler":{"bash":"bash \"${POLYTOKEN_CONFIG_DIR:-$HOME/.config/polytoken}/hooks/adapter.sh\" large-read-guard/hook.sh read"},"matcher":"file_read","name":"large-read-guard"},
  {"event":"post_model_turn","handler":{"bash":"exec polytoken-quota notice-hook --notice \"$HOME/.local/polytoken-quota/notice.json\""},"name":"polytoken-quota-reload"},
  {"event":"pre_user_prompt","handler":{"bash":"exec polytoken-quota notice-hook --notice \"$HOME/.local/polytoken-quota/notice.json\""},"name":"polytoken-quota-drift"}
]
