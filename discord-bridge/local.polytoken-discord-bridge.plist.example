<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.polytoken-discord-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>@WRAPPER@</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/discord-bridge.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/discord-bridge.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>@HOME@</string>
    <key>BRIDGE_REPO_DIR</key><string>@REPO@</string>
    <key>BRIDGE_HOST_PYTHON</key><string>@PYTHON@</string>
  </dict>
</dict>
</plist>
